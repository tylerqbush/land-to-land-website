---
pagination:
  data: properties
  size: 1
  alias: prop
permalink: "property/{{ prop.slug }}/index.html"
layout: base.njk
# The layout reads `title` and `description` from page data. A {% set %} in
# the template body never reaches it, which left every property page with the
# same generic browser-tab title and meta description.
eleventyComputed:
  title: "{{ prop.name }} | Land to Land Holdings"
  description: "{{ prop.description | truncate(155) }}"
---

{# ── HERO ── #}
<div class="listing-hero">
  <img class="listing-hero__img" src="{{ prop.photos[0] }}" alt="{{ prop.name }}" fetchpriority="high">
  <div class="listing-hero__overlay"></div>
  <div class="listing-hero__content">
    <div class="container">
      <span class="badge badge-{{ prop.status | lower | replace(' ', '-') | replace('under-contract', 'contract') }} mb-3" style="display:inline-block;">{{ "Available" if (prop.status | trim) == "Active" else prop.status }}</span>
      <h1 class="listing-hero__title">{{ prop.name }}</h1>
      <p class="listing-hero__meta">{{ prop.acreage }} acres &middot; {{ prop.county }} County, {{ prop.state }} &middot; {{ prop.id }}</p>
    </div>
  </div>
</div>

{# ── NARRATIVE: PHOTO GRID + "WHAT YOU'RE ACTUALLY GETTING" ── #}
<section class="section listing-narrative-section">
  <div class="container">
    <div class="listing-narrative-grid">

      {# LEFT: gallery. Tabs are radio buttons styled with CSS, so they work without JavaScript. #}
      {% set hasMap = prop.lat and prop.lng %}
      {% set hasVideo = prop.video_url %}
      <div class="gallery-tabs">
        {% if hasMap or hasVideo %}
        <input class="gallery-tabs__input" type="radio" name="gallery-tab" id="tab-photos" checked>
        {% if hasMap %}<input class="gallery-tabs__input" type="radio" name="gallery-tab" id="tab-map">{% endif %}
        {% if hasVideo %}<input class="gallery-tabs__input" type="radio" name="gallery-tab" id="tab-video">{% endif %}
        <div class="gallery-tabs__bar" role="tablist">
          <label for="tab-photos">Photos</label>
          {% if hasMap %}<label for="tab-map">Map</label>{% endif %}
          {% if hasVideo %}<label for="tab-video">Video</label>{% endif %}
        </div>
        {% endif %}
        <div class="gallery-tabs__panel gallery-tabs__panel--photos">
      <div class="listing-photo-grid">
        <a href="{{ prop.photos[0] }}" target="_blank" rel="noopener" class="listing-photo-grid__main js-lightbox-trigger" data-photos="{{ prop.photos | json }}" data-index="0">
          <img src="{{ prop.photos[0] }}" alt="Main photo of {{ prop.name }}" fetchpriority="high" width="900" height="600">
        </a>
        {% if prop.photos.length > 1 %}
        <div class="listing-photo-grid__thumbs">
          <a href="{{ prop.photos[1] }}" target="_blank" rel="noopener" class="listing-photo-grid__thumb js-lightbox-trigger" data-photos="{{ prop.photos | json }}" data-index="1">
            <img src="{{ prop.photos[1] }}" alt="Photo 2 of {{ prop.name }}" loading="lazy" width="480" height="320">
          </a>
          {% if prop.photos.length > 2 %}
          <a href="{{ prop.photos[2] }}" target="_blank" rel="noopener" class="listing-photo-grid__thumb listing-photo-grid__thumb--more js-lightbox-trigger" data-photos="{{ prop.photos | json }}" data-index="2">
            <img src="{{ prop.photos[2] }}" alt="Photo 3 of {{ prop.name }}" loading="lazy" width="480" height="320">
            {% if prop.photos.length > 3 %}
            <span class="listing-photo-grid__count">+{{ prop.photos.length - 3 }} more</span>
            {% endif %}
          </a>
          {% endif %}
        </div>
        {% endif %}
      </div>
        </div>
        {% if hasMap %}
        <div class="gallery-tabs__panel gallery-tabs__panel--map">
          <iframe src="https://maps.google.com/maps?q={{ prop.lat }},{{ prop.lng }}&z=14&output=embed" width="100%" height="100%" style="border:0;display:block;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Property location map"></iframe>
        </div>
        {% endif %}
        {% if hasVideo %}
        {% set yt_id = prop.video_url | replace("https://www.youtube.com/embed/", "") | replace("https://youtu.be/", "") %}
        <div class="gallery-tabs__panel gallery-tabs__panel--video">
          <div class="yt-facade" data-src="{{ prop.video_url }}?autoplay=1" aria-label="Play property video" role="button" tabindex="0">
            <img class="yt-facade__thumb" src="https://img.youtube.com/vi/{{ yt_id }}/hqdefault.jpg" loading="lazy" decoding="async" alt="Property video thumbnail" width="480" height="360">
            <button class="yt-facade__btn" aria-label="Play video">
              <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.52 7.74C65.69 4.66 63.29 2.22 60.23 1.38 54.98 0 34 0 34 0S13.02 0 7.77 1.38C4.71 2.22 2.31 4.66 1.48 7.74 0 13.05 0 24 0 24s0 10.95 1.48 16.26c.83 3.08 3.23 5.52 6.29 6.36C13.02 48 34 48 34 48s20.98 0 26.23-1.38c3.06-.84 5.46-3.28 6.29-6.36C68 34.95 68 24 68 24s0-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
            </button>
          </div>
          <noscript><p><a href="{{ prop.video_url }}" target="_blank" rel="noopener">Watch the video</a></p></noscript>
          <script src="/assets/js/yt-facade.js" defer></script>
        </div>
        {% endif %}
      </div>

      {# Lightbox modal — hidden by default, populated by assets/js/lightbox.js #}
      <div id="photo-lightbox" class="lightbox-overlay" hidden>
        <button type="button" class="lightbox-close" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <button type="button" class="lightbox-prev" aria-label="Previous photo">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="lightbox-next" aria-label="Next photo">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <figure class="lightbox-figure">
          <img class="lightbox-img" src="" alt="">
          <figcaption class="lightbox-caption"></figcaption>
        </figure>
      </div>

      {# RIGHT: narrative + feature bullets #}
      <div class="listing-narrative-col">
        <p class="listing-eyebrow">Property at a Glance</p>
        <h2 class="listing-narrative-heading">What You're Actually Getting</h2>

        {# A source-written description (src/_data/listingBlurbs.json) wins
           over the generated narrative/description, but only while its apn
           matches this record's apn, so it can never attach to the wrong parcel. #}
        {% set blurb = listingBlurbs[prop.id] %}
        <div class="listing-narrative-body">
          {% if blurb and blurb.apn == prop.apn %}
            {% for para in blurb.paragraphs %}<p>{{ para }}</p>{% endfor %}
          {% elif prop.narrative %}
            {{ prop.narrative | safe }}
          {% else %}
            <p>{{ prop.description }}</p>
          {% endif %}
        </div>

        {# Feature bullets — use generated ones if available, else auto-derive #}
        <ul class="listing-feature-bullets">
          {% if prop.narrative_bullets %}
            {% for b in prop.narrative_bullets %}
            <li class="listing-feature-bullet">
              <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div>
                <strong>{{ b.title }}</strong>
                <span>{{ b.description }}</span>
              </div>
            </li>
            {% endfor %}
          {% else %}
            {# Auto-derived bullets from property data #}
            {% set bc = 0 %}

            {% if bc < 3 and prop.flood_plain and 'no' in prop.flood_plain | lower %}
              <li class="listing-feature-bullet">
                <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                <div><strong>No Flood Zone</strong><span>This parcel sits in Flood Zone X. No flood insurance required.</span></div>
              </li>
              {% set bc = bc + 1 %}
            {% endif %}

            {% if bc < 3 and prop.elevation and prop.elevation | trim %}
              <li class="listing-feature-bullet">
                <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 20 9 4 15 14 19 10 21 20 3 20"/></svg>
                <div><strong>Elevated Site</strong><span>Located at {{ prop.elevation | trim }}, well above surrounding terrain.</span></div>
              </li>
              {% set bc = bc + 1 %}
            {% endif %}

            {% if bc < 3 and prop.zoning and prop.zoning | trim and 'no zoning' not in prop.zoning | lower and 'no "zoning"' not in prop.zoning | lower %}
              <li class="listing-feature-bullet">
                <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
                <div><strong>Clear Zoning</strong><span>{{ prop.zoning | trim | truncate(80, true, "...") }}</span></div>
              </li>
              {% set bc = bc + 1 %}
            {% endif %}

            {% if bc < 3 and prop.full_time_rv and prop.full_time_rv | lower | truncate(3, false, "") == "yes" %}
              <li class="listing-feature-bullet">
                <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="8" width="15" height="10" rx="1"/><path d="M16 11h3l2 3H16v-3z"/><circle cx="5" cy="19" r="1.5"/><circle cx="13" cy="19" r="1.5"/></svg>
                <div><strong>Full-Time RV Living Allowed</strong><span>Park your rig permanently. No time limits.</span></div>
              </li>
              {% set bc = bc + 1 %}
            {% endif %}

            {% if bc < 3 and (prop.single_family_allowed and prop.single_family_allowed | trim) or (prop.manufactured_allowed and prop.manufactured_allowed | lower | truncate(3, false, "") == "yes") %}
              <li class="listing-feature-bullet">
                <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9.5L12 3l9 6.5V21H3V9.5z"/><path d="M9 21v-8h6v8"/></svg>
                <div><strong>Build-Ready</strong><span>{% if prop.single_family_allowed and prop.single_family_allowed | trim %}Site-built homes permitted.{% endif %}{% if prop.manufactured_allowed and prop.manufactured_allowed | lower | truncate(3, false, "") == "yes" %} Manufactured homes also allowed.{% endif %}</span></div>
              </li>
              {% set bc = bc + 1 %}
            {% endif %}

            {% if bc < 3 and prop.solar and prop.solar | lower | truncate(3, false, "") == "yes" %}
              <li class="listing-feature-bullet">
                <svg class="listing-feature-bullet__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.22" y1="4.22" x2="7.05" y2="7.05"/><line x1="16.95" y1="16.95" x2="19.78" y2="19.78"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.22" y1="19.78" x2="7.05" y2="16.95"/><line x1="16.95" y1="7.05" x2="19.78" y2="4.22"/></svg>
                <div><strong>Solar-Ready</strong><span>Solar power is a viable energy option for this parcel.</span></div>
              </li>
              {% set bc = bc + 1 %}
            {% endif %}

          {% endif %}
        </ul>

      </div>
    </div>
  </div>
</section>

{# ── FIT: WHO THIS PARCEL IS (AND ISN'T) FOR ──
   Hand-written per listing in src/_data/listingFit.json. Renders only for
   Active listings and only while the entry's apn matches this record's apn,
   so text can never attach to the wrong parcel. #}
{% set fit = listingFit[prop.id] %}
{% if fit and fit.apn == prop.apn and prop.status == "Active" %}
<section class="section fit-section">
  <div class="container">
    <p class="listing-eyebrow text-center">Straight Talk</p>
    <h2 class="heading-md mb-8 text-center">Is this the right parcel for you?</h2>
    <div class="fit-grid">
      <div class="fit-card fit-card--good">
        <p class="fit-card__label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          What it's good for
        </p>
        <p class="fit-card__text">{{ fit.good }}</p>
      </div>
      <div class="fit-card fit-card--not">
        <p class="fit-card__label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          What it's not good for
        </p>
        <p class="fit-card__text">{{ fit.not }}</p>
      </div>
    </div>
  </div>
</section>
{% endif %}

{# ── LIFESTYLE: WHY BUYERS CHOOSE THIS MARKET ── #}
{# Market copy is written per county. Use it only when the county matches;
   otherwise show the generic block instead of another county's copy. #}
{% set market = marketLifestyle.markets[prop.county ~ "|" ~ prop.state] %}
{% if not market %}{% set market = marketLifestyle.fallback %}{% endif %}
<section class="lifestyle-section">
  <div class="container">
    <p class="listing-eyebrow text-center">Quick Look</p>
    <h2 class="lifestyle-section__heading">{{ market.heading }}</h2>
    <p class="lifestyle-section__subtext">{{ market.subtext }}</p>
    <div class="lifestyle-row">
      {% for item in market.items %}
      <div class="lifestyle-item">
        {{ marketLifestyle.icons[item.icon] | safe }}
        <span>{{ item.title }}</span>
        <p>{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ── RULES & ZONING ── #}
<section class="section rules-section">
  <div class="container">
    <h2 class="heading-md mb-2 text-center">Property Rules &amp; Zoning</h2>
    <p class="rules-section__zoning text-center mb-8">Zoning: <strong>{{ prop.zoning | zoningDisplay }}</strong></p>
    <div class="rules-grid">
      {% for callout in prop | zoningCallouts %}
        <div class="rule-item">
          <span class="rule-item__check rule-item__check--yes">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="rule-item__label">{{ callout }}</span>
        </div>
      {% endfor %}
    </div>

    {# What the county allows. Statuses come from the Airtable Yes/No use
       fields (see allowedUses in scripts/lib/utils.mjs); text that can't be
       read with confidence is shown as written. For listings still for sale. #}
    {% if prop.status == "Active" or prop.status == "Under Contract" %}
    {% set uses = prop | allowedUses %}
    {% set county = countyPlanning[prop.county ~ "|" ~ prop.state] %}
    <div class="uses-card">
      <h3 class="uses-card__heading">What the county allows here</h3>
      <p class="uses-card__intro">From our due diligence on this parcel. County rules change, so confirm with the county before you buy.</p>
      {% if uses.hasAnswers %}
        {% for group in uses.groups %}
        <div class="uses-group">
          <p class="uses-group__title">{{ group.title }}</p>
          <ul class="uses-list">
            {% for row in group.rows %}
            <li class="uses-row">
              <span class="uses-row__label">{{ row.label }}</span>
              <span class="uses-row__body">
                {% if row.chip %}<span class="uses-chip uses-chip--{{ row.status }}">{{ row.chip }}</span>{% endif %}
                {% if row.note %}<span class="uses-row__note">{{ row.note }}</span>{% endif %}
              </span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      {% else %}
        <p class="uses-card__empty">We don't have use details on file for this parcel yet. Text us and we'll tell you what we know, and check with the county before you decide.</p>
      {% endif %}
      <p class="uses-card__county">
        {% if county %}
          {{ county.name }} decides what is allowed, not us.
          Call <a href="tel:{{ county.tel }}">{{ county.phone }}</a>{% if county.phoneNote %} ({{ county.phoneNote }}){% endif %}
          or <a href="{{ county.url }}" target="_blank" rel="noopener">visit their page</a>.
        {% else %}
          The county planning department decides what is allowed, not us. Check with them before you buy.
        {% endif %}
      </p>
    </div>
    {% endif %}
  </div>
</section>

{# Active listings with no GeekPay link get no buy button (see
   showBuyButton). They show a "text us for the payment link" line
   instead, with the property pre-filled in the message. #}
{% set paymentLinkTextHref = "sms:7069630017?&body=" + (("Hi, can I get the payment link for the " + prop.acreage + " acre property in " + prop.city + ", " + prop.state + " (ID " + prop.id + ")?") | urlencode) %}

{# ── FINANCING OPTIONS ── #}
{# Sold listings are kept as social proof and often predate the current
   pricing fields (see scripts/sync.mjs validateRecord), so this whole
   section is skipped rather than rendering blank/TBD financing numbers
   for a property that's no longer for sale. #}
{% if prop.monthly %}
<section class="financing-section">
  <div class="container">
    <p class="eyebrow mb-2 text-center" style="color:rgba(255,255,255,0.5);">No Banks. No Credit Check.</p>
    <h2 class="heading-md mb-8 text-center" style="color:var(--color-white);">Financing Options</h2>
    <div class="financing-grid">
      <div class="financing-cash-card">
        <div class="financing-card__label">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M9 9.5c0-1.1 1.3-2 3-2s3 .9 3 2-1.3 2-3 2-3 .9-3 2 1.3 2 3 2 3-.9 3-2"/></svg>
          <span>Cash Price</span>
        </div>
        {% if prop.cash_price %}
          <p class="financing-cash-card__price">${{ prop.cash_price | numberFormat }}</p>
          <p class="financing-cash-card__note">One-time payment. Own it outright.</p>
        {% else %}
          <p class="financing-cash-card__price" style="font-size:20px;line-height:1.4;">We accept all reasonable cash offers.</p>
          <p class="financing-cash-card__note">Contact us to discuss pricing.</p>
        {% endif %}
      </div>
      <div class="financing-terms-card">
        <div class="financing-card__label">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          <span>Owner Financing</span>
        </div>
        <table class="financing-table">
          {% set start = prop | costToStart %}
          {% if start and prop.status != "Sold" %}
          <tr class="financing-table__start"><td>To start today<span class="financing-table__sub">down payment + doc fee</span></td><td class="financing-table__highlight">${{ start.total | numberFormat }}</td></tr>
          {% endif %}
          <tr><td>Down Payment</td><td>{% if prop.down %}${{ prop.down }}{% else %}TBD{% endif %}</td></tr>
          <tr><td>Monthly Payment</td><td class="financing-table__highlight">${{ prop.monthly }}/mo</td></tr>
          {% set bf = prop | saleTerms(sale.termCut) if (sale.live and prop.status == "Active") else null %}
          {% if bf %}
          <tr><td>Term</td><td><s>{{ prop.term_months }} months</s> <strong>{{ bf.saleTerm }} months</strong></td></tr>
          <tr><td>Black Friday Savings</td><td class="financing-table__highlight">${{ bf.savings | numberFormat }} ({{ bf.pct }}% off total payments)</td></tr>
          {% elif prop.term_months %}<tr><td>Term</td><td>{{ prop.term_months }} months</td></tr>{% endif %}
          <tr><td>Doc Fee</td><td>{% if prop.doc_fee %}${{ prop.doc_fee }}{% else %}TBD{% endif %}</td></tr>
        </table>
        {# What a buyer is actually billed each month (monthlyBill in
           scripts/lib/utils.mjs). The total only appears when the service
           fee and the property tax are both on file. #}
        {% set bill = prop | monthlyBill %}
        {% if bill and prop.status != "Sold" %}
        <div class="bill-breakdown">
          <p class="bill-breakdown__title">Your monthly bill</p>
          <table class="financing-table">
            <tr><td>Monthly payment</td><td>${{ bill.payment | money }}</td></tr>
            {% if bill.serviceFee !== null %}<tr><td>Service fee</td><td>+ ${{ bill.serviceFee | money }}</td></tr>{% endif %}
            {% if bill.taxShare !== null %}<tr><td>Property tax (est.)</td><td>+ ${{ bill.taxShare | money }}</td></tr>{% endif %}
            {% if bill.total !== null %}<tr class="bill-breakdown__total"><td>Billed monthly</td><td class="financing-table__highlight">${{ bill.total | money }}</td></tr>{% endif %}
          </table>
          <p class="bill-breakdown__note">
            {% if bill.total !== null %}
              Property tax is the county's annual bill divided by 12, so it can change each year.
            {% else %}
              {% if bill.serviceFee === null %}A monthly service fee also applies. {% endif %}{% if bill.taxShare === null %}Your share of the county property tax is added to each payment. {% endif %}Text us for the exact monthly amount.
            {% endif %}
          </p>
        </div>
        {% endif %}
        <p class="financing-terms-card__note">No credit check required.{% if bf %} Black Friday terms: same monthly payment, {{ bf.removed }} fewer payments. Pay the down payment and doc fee by Monday, Nov 30 at 11:59pm ET.{% endif %}</p>
      </div>
    </div>
    <div class="financing-cta text-center mt-8">
      {% if prop | showBuyButton %}
        <a href="{{ prop.geekpay_url }}" target="_blank" rel="noopener" class="btn-buy">Secure This Property &rarr;</a>
      {% elif prop.status == "Active" %}
        <p class="payment-text-cta">To get your payment link, text <a href="{{ paymentLinkTextHref }}">706-963-0017</a>.</p>
      {% else %}
        <a href="#ask-question" class="btn btn-primary">Ask a Question</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}



{# ── DETAIL TABLE ── #}
<section class="section specs-section">
  <div class="container">
    <p class="eyebrow mb-2 text-center" style="color:var(--color-terra);">Full Specs</p>
    <h2 class="heading-md mb-4 text-center">For the Detail Oriented</h2>
    <p class="specs-section__intro">We know that detail-oriented buyers want the full picture. That's why we've included every bit of information we have about this property. If you have questions, reach out and we'll do our best to help.</p>

    <div class="disclaimer mb-8">READ THIS: We are not the Planning and Zoning department and while we try to answer common questions about what the property can be used for, we can't provide a yes or no answer for every circumstance. Land to Land Holdings LLC or its affiliates make no warranty or guarantee, either expressed or implied relative to usability, the exact location, desirability, or usefulness of the properties. Buyer is solely responsible for determining the condition of the property. All information is deemed reliable but not guaranteed. Buyer is required to complete their own due diligence prior to purchasing.</div>

    <div class="spec-card">
      <p class="detail-group__heading">Property Specifications</p>
      <div class="spec-card__cols">
        <table class="listing-table">
          <tr><td>County</td><td>{{ prop.county }}, {{ prop.state }}</td></tr>
          <tr><td>APN</td><td>{% if prop.apn %}{{ prop.apn }}{% else %}Not specified{% endif %}</td></tr>
          {% if prop.address %}<tr><td>Address</td><td>{{ prop.address }}</td></tr>{% endif %}
          <tr><td>Terrain</td><td>{% if prop.terrain %}{{ prop.terrain }}{% else %}Not specified{% endif %}</td></tr>
          <tr><td>Access Road</td><td>{% if prop.road_access %}{{ prop.road_access }}{% else %}Not specified{% endif %}</td></tr>
          <tr><td>Sewer/Septic</td><td>{% if prop.septic_required %}{{ prop.septic_required }}{% elif prop.septic %}{{ prop.septic }}{% else %}Not specified{% endif %}</td></tr>
          <tr><td>Gas</td><td>{% if prop.gas and prop.gas != "Unknown" %}{{ prop.gas }}{% elif prop.propane %}{{ prop.propane }}{% else %}Not specified{% endif %}</td></tr>
          <tr><td>HOA / Fees</td><td>None</td></tr>
        </table>
        <table class="listing-table">
          <tr><td>Zoning</td><td>{{ prop.zoning | zoningDisplay }}</td></tr>
          <tr><td>Acreage</td><td>{{ prop.acreage }} Acres</td></tr>
          {% if prop.lot_dimensions %}<tr><td>Lot Dimensions</td><td>{% for line in prop.lot_dimensions | splitLines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endif %}
          {% if prop.annual_taxes %}<tr><td>Annual Taxes</td><td>${{ prop.annual_taxes }} per year</td></tr>{% endif %}
          <tr><td>Elevation</td><td>{% if prop.elevation %}{{ prop.elevation }}{% else %}Not specified{% endif %}</td></tr>
          <tr><td>Water</td><td>{% if prop.well %}{{ prop.well }}{% else %}Not specified{% endif %}</td></tr>
          <tr><td>Electric</td><td>{% if prop.electricity %}{{ prop.electricity }}{% else %}Not specified{% endif %}</td></tr>
        </table>
      </div>
    </div>

    <div class="text-center mt-8 mb-8">
      {% if prop | showBuyButton %}
        <a href="{{ prop.geekpay_url }}" target="_blank" rel="noopener" class="btn-buy">Reserve This Property &rarr;</a>
        <p class="specs-section__cta-note">Secure, encrypted checkout via GeekPay.io</p>
      {% elif prop.status == "Active" %}
        <p class="payment-text-cta">To get your payment link, text <a href="{{ paymentLinkTextHref }}">706-963-0017</a>.</p>
      {% else %}
        <a href="mailto:info@landtolandholdings.com?subject={{ ('Payment link request: ' + prop.name) | urlencode }}" class="btn-buy">Request Payment Link &rarr;</a>
        <p class="specs-section__cta-note">We'll email you a secure payment link.</p>
      {% endif %}
    </div>

    {% if prop.lat and prop.lng %}
    <div class="spec-card">
      <p class="detail-group__heading">GPS Coordinates</p>
      <table class="listing-table">
        <tr><td>Decimal</td><td>{{ prop.lat }}, {{ prop.lng }}</td></tr>
        <tr><td>DMS</td><td>{{ prop.lat | dms(prop.lng) }}</td></tr>
        <tr><td>Google Maps</td><td><a href="{{ prop.google_maps_url }}" target="_blank" rel="noopener" style="color:var(--color-forest);font-weight:700;">Open &rarr;</a></td></tr>
      </table>
    </div>
    {% endif %}
  </div>
</section>

{# ── FULL-BLEED PHOTO BREAK (auto-slides through all photos via assets/js/photo-slider.js; no-JS fallback is just the first photo, static) ── #}
{% if prop.photos[0] %}
<div class="listing-photo-break photo-slider" data-photos="{{ prop.photos | json }}">
  <div class="photo-slider__track">
    {% for photo in prop.photos %}
    <img src="{{ photo }}" alt="{{ prop.name }}" loading="lazy" class="photo-slider__img">
    {% endfor %}
  </div>
  {% if prop.photos.length > 1 %}
  <div class="photo-slider__dots">
    {% for photo in prop.photos %}
    <span class="photo-slider__dot{% if loop.index0 == 0 %} photo-slider__dot--active{% endif %}"></span>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}

{# ── LOCATION ── #}
<section class="section">
  <div class="container">
    <p class="eyebrow mb-2" style="color:var(--color-terra);">Where You'll Own</p>
    <h2 class="heading-md mb-4">Location</h2>
    {% if prop.lat and prop.lng %}
      <iframe
        src="https://maps.google.com/maps?q={{ prop.lat }},{{ prop.lng }}&z=14&output=embed"
        width="100%"
        height="400"
        style="border:0;border-radius:var(--radius-card);display:block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Property location map"></iframe>
    {% endif %}
    <p class="mt-4" style="font-size:13px;color:var(--color-text-muted);">GPS: {{ prop.gps }} | <a href="{{ prop.google_maps_url }}" target="_blank" rel="noopener" style="color:var(--color-forest);font-weight:700;">Open in Google Maps &rarr;</a></p>
  </div>
</section>

{# ── SIMILAR PARCELS ── #}
{% set similar = prop | similarParcels(properties, 3) %}
{% if similar.length %}
<section class="section">
  <div class="container">
    <p class="eyebrow mb-2" style="color:var(--color-terra);">Keep Looking</p>
    <h2 class="heading-md mb-4">Similar parcels available now</h2>
    <div class="card-grid">
      {% set current = prop %}
      {% for prop in similar %}
        {% include "partials/property-card.njk" %}
      {% endfor %}
    </div>
    {% if countyGuides | selectattr("county", "equalto", current.county) | selectattr("abbr", "equalto", current.state) | list | length %}
    <p class="mt-4" style="font-size:14px;"><a href="/county/{{ current.county | lower | replace(' ', '-') }}-{{ current.state | lower }}/">{{ current.county }} County guide</a> &middot; <a href="/properties/">All properties</a></p>
    {% endif %}
  </div>
</section>
{% endif %}

{# ── ASK A QUESTION ── #}
<section class="section section-off" id="ask-question">
  <div class="container" style="max-width:640px;">
    <p class="eyebrow mb-2" style="color:var(--color-terra);">Get in Touch</p>
    <h2 class="heading-md mb-2">Have Questions?</h2>
    <p style="color:var(--color-text-muted);margin-bottom:var(--space-6);">Reach out directly and we'll get back to you fast.</p>
    <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;">
      <a href="tel:6783361879" class="btn btn-primary">Call 678-336-1879</a>
      <a href="mailto:info@landtolandholdings.com" class="btn btn-outline">Email Us</a>
    </div>
  </div>
</section>

{# Sticky "text us" bar, phones only (CSS hides it on wider screens). Active
   listings only. Opens a text to Tyler with the property already filled in.
   No JavaScript involved. #}
{% if prop.status == "Active" %}
{% set stickyTextHref = "sms:7069630017?&body=" + (("Hi, I'm interested in the " + prop.acreage + " acre property in " + prop.city + ", " + prop.state + " (ID " + prop.id + "). Can you tell me more?") | urlencode) %}
<div class="sticky-cta">
  <a href="{{ stickyTextHref }}" class="btn btn-primary btn-full">Text us about this property</a>
</div>
{% endif %}

<script src="/assets/js/lightbox.js" defer></script>
<script src="/assets/js/photo-slider.js" defer></script>

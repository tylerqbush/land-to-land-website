<div class="sale-banner" id="sale-banner" data-sale-phase="{{ sale.phase }}">
  <p class="sale-banner__text">
    {% if sale.live %}
    Black Friday: 30% off total payments on every owner-financed property. Same monthly payment, fewer payments. Ends Monday, Nov 30 at midnight ET.
    <a href="/properties/" class="sale-banner__cta">See properties</a>
    {% else %}
    Black Friday starts Friday, Nov 27: 30% off total payments on owner-financed land. Same monthly payment, fewer payments.
    <a href="/properties/" class="sale-banner__cta">Browse properties</a>
    {% endif %}
  </p>
  <button class="sale-banner__close" data-sale-dismiss aria-label="Dismiss sale banner">&times;</button>
</div>

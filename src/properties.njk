---
layout: base.njk
title: "Browse Properties - Land to Land Holdings"
description: "Browse available owner-financed land across Florida, New Mexico, and Oregon. Filter by state, county, and availability."
---

<section class="section">
  <div class="container">
    <p class="eyebrow mb-2" style="color:var(--color-terra);">Browse Listings</p>
    <h1 class="heading-lg mb-6">Browse Properties</h1>

    {# Filter bar #}
    <div class="filter-bar" role="search" aria-label="Filter properties">
      <select id="filter-state" aria-label="Filter by state">
        <option value="">All States</option>
        {% for state in filterOptions.states %}
          <option value="{{ state }}">{{ state | stateName }}</option>
        {% endfor %}
      </select>
      <select id="filter-county" aria-label="Filter by county">
        <option value="">All Counties</option>
        {% for c in filterOptions.counties %}
          <option value="{{ c.county }}">{{ c.county }} ({{ c.state }})</option>
        {% endfor %}
      </select>
      <select id="filter-status" aria-label="Filter by availability">
        <option value="">All Listings</option>
        <option value="Active">Available</option>
        <option value="Under Contract">Under Contract</option>
        <option value="Sold">Sold</option>
      </select>
    </div>

    {# Property card grid — Active first, then everything else #}
    <div class="card-grid" id="property-grid">
      {% for prop in properties %}
        {% if prop.status == "Active" %}
          {% include "partials/property-card.njk" %}
        {% endif %}
      {% endfor %}
      {% for prop in properties %}
        {% if prop.status != "Active" %}
          {% include "partials/property-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script src="/assets/js/filter.js" defer></script>
